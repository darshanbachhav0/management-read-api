# Render sets PORT automatically. For local development you may use 8088.
PORT=8088
NODE_ENV=development

# API key(s) shared with external read-only consumers. Comma-separated.
VIEWER_API_KEYS=replace-with-a-long-random-key

# Browser origins allowed to call this API directly, comma-separated.
# Same-origin access to the built-in viewer is always allowed.
# Example after deploying another frontend:
# ALLOWED_ORIGINS=https://partner-dashboard.onrender.com,https://example.com
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

RATE_LIMIT_PER_MINUTE=120
CACHE_TTL_SECONDS=30
REQUEST_TIMEOUT_MS=10000

# Existing UMA Finance backend. IMPORTANT: Render cannot reach localhost on
# your computer. Use a publicly reachable HTTPS URL or a private Render URL.
# Include /api.
FINANCE_API_BASE_URL=https://your-finance-backend.example.com/api

# Dedicated Management service account in the existing Finance system.
# Keep these credentials only on the server/Render environment.
FINANCE_SERVICE_EMAIL=management-view-api@uma.edu.pe
FINANCE_SERVICE_PASSWORD=replace-with-strong-random-password
FINANCE_REQUIRED_ROLE=MANAGEMENT
