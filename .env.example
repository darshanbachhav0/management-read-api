# Render automatically supplies PORT. For local development the app defaults to 8088.
PORT=8088
NODE_ENV=development

# You can use EITHER the Finance backend root URL OR its /api URL.
# Both examples are accepted by v1.2.0:
# FINANCE_API_BASE_URL=https://uma-finance-backend.onrender.com
# FINANCE_API_BASE_URL=https://uma-finance-backend.onrender.com/api
FINANCE_API_BASE_URL=http://localhost:5000

# Dedicated active user in UMA Finance with role Management.
FINANCE_SERVICE_EMAIL=management-view-api@uma.edu.pe
FINANCE_SERVICE_PASSWORD=change-me
FINANCE_REQUIRED_ROLE=MANAGEMENT

# Give viewer keys to read-only consumers. Multiple keys may be comma-separated.
VIEWER_API_KEYS=fIBNznTlMuvckIZvUu2SlDdB-nTZH_XL3bxKKffuss

# Leave empty for the built-in same-origin dashboard.
# Add browser origins only if another frontend calls the API directly.
ALLOWED_ORIGINS=

RATE_LIMIT_PER_MINUTE=120
CACHE_TTL_SECONDS=30
REQUEST_TIMEOUT_MS=10000
